<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" Version="0.15.8" />
    <PackageReference Include="ClosedXML" Version="0.105.0" />
    <PackageReference Include="CompareNETObjects" Version="4.84.0" />
    <PackageReference Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" Version="1.21.0" />
    <!-- SonarAnalyzer: kept as analyzer-only package (no lib/ folder).
         ExcludeAssets=analyzers stops it running on *our* code during build.
         GeneratePathProperty lets the target below copy the DLL to output
         so we can load it at runtime for programmatic per-snippet analysis. -->
    <PackageReference Include="SonarAnalyzer.CSharp" Version="10.27.0.140913">
      <ExcludeAssets>analyzers</ExcludeAssets>
      <GeneratePathProperty>true</GeneratePathProperty>
    </PackageReference>
  </ItemGroup>

  <!-- Copy SonarAnalyzer.CSharp.dll to the output directory so the program
       can load it at runtime via Assembly.LoadFrom. -->
  <Target Name="CopySonarAnalyzerToOutput" AfterTargets="Build">
    <Copy SourceFiles="$(PkgSonarAnalyzer_CSharp)\analyzers\SonarAnalyzer.CSharp.dll"
          DestinationFolder="$(OutputPath)"
          SkipUnchangedFiles="true" />
  </Target>

</Project>
